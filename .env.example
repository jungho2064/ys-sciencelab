# Supabase 연동 설정 (science_lab 전용 스키마)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
NEXT_PUBLIC_SUPABASE_SCHEMA=science_lab

# 교사(전자칠판) 모드 기본 관리자 PIN 번호 (기본값: 1234)
NEXT_PUBLIC_TEACHER_PIN=1234

# AI 탐구 코치용 Gemini API Key (Google AI Studio / GCP)
GEMINI_API_KEY=your_gemini_api_key_here
